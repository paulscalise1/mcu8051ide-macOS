# Can ignore specific files
.DS_Store

# Use wildcards as well
*~
*.swp

# Can also ignore all directories and files in a directory.
tmp/**/*

# macOS native build artifacts (generated by macos_setup.sh)
macos_packages/

# App bundle output (generated by build_app.sh)
build/

# Distribution / signing script (contains personal signing identity)
dist.sh

# Built DMGs — upload as GitHub release assets, not committed to repo
distribution/*.dmg

# Scratch/debug images used during development
debug_images/
